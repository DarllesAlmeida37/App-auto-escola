generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoVeiculo {
  CARRO
  MOTO
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

model Aluno {
  id           Int           @id @default(autoincrement())
  nome         String
  cpf          String        @unique
  telefone     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  agendamentos Agendamento[]
  lotes        AgendamentoLote[]
}

model Instrutor {
  id           Int           @id @default(autoincrement())
  nome         String
  cpf          String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  agendamentos Agendamento[]
}

model Agendamento {
  id          Int         @id @default(autoincrement())
  data        DateTime    @db.Date
  horario     String
  veiculo     TipoVeiculo

  alunoId     Int
  instrutorId Int
  loteId      Int?

  aluno       Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  instrutor   Instrutor   @relation(fields: [instrutorId], references: [id], onDelete: Cascade)
  lote        AgendamentoLote? @relation(fields: [loteId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([alunoId, data, horario])
  @@unique([instrutorId, data, horario])
}

model AgendamentoLote {
  id       Int           @id @default(autoincrement())
  alunoId  Int
  criadoEm DateTime      @default(now())

  aluno    Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aulas    Agendamento[]
}

model SenhaAcesso {
  id        Int      @id @default(autoincrement())
  senhaHash String
  criadoEm  DateTime @default(now())
}

model AdminGeral {
  id        Int      @id @default(autoincrement())
  senhaHash String
  criadoEm  DateTime @default(now())
}

model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  fechando  Boolean  @default(false)
}

model Veiculo {
  id        Int        @id @default(autoincrement())
  placa     String     @unique
  cor       String
  tipo      TipoVeiculo
  createdAt DateTime   @default(now())

  despesas  Despesa[]
}

model Despesa {
  id        Int      @id @default(autoincrement())
  valor     Decimal  @db.Decimal(10, 2)
  descricao String
  data      DateTime @db.Date
  veiculoId Int
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Lancamento {
  id        Int            @id @default(autoincrement())
  tipo      TipoLancamento
  valor     Decimal        @db.Decimal(10, 2)
  descricao String
  data      DateTime       @db.Date
  criadoEm  DateTime       @default(now())
}